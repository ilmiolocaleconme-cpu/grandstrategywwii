      "by": [
        "aluminium"
      ],
      "fallback": "population",
      "basis": "data",
      "why": "centri di fonderia di resource_points.json (sezione products)"
    },
    "FCT-RUBBER": {
      "by": [
        "rubber"
      ],
      "fallback": "population",
      "why": "gomma naturale dove si coltiva, altrimenti vicino alla manodopera"
    }

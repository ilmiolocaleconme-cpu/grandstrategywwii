{
  "name": "grandstrategywwii",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grand Strategy WWII - mobile grand-strategy game",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.js",
    "build:adjacency": "node scripts/build-adjacency.js",
    "build:sea": "node scripts/build-sea.js",
    "build:labels": "node scripts/build-labels.js",
    "build:links": "node scripts/build-links.js",
    "build:city-links": "node scripts/build-city-links.js",
    "build:province-industry": "node scripts/build-province-industry.js",
    "build:resource-locations": "node scripts/build-resource-locations.js",
    "build:province-resources": "node scripts/build-province-resources.js",
    "build:industry": "node scripts/build-initial-industry.js",
    "build:resource-points": "node scripts/build-resource-points.js",
    "build:transport": "node scripts/build-transport.js",
    "build:hydro": "node scripts/build-hydro.js",
    "build:terrain": "python3 -I scripts/terrain/build_terrain.py",
    "build:production": "node scripts/build-production.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
